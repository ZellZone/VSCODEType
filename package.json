{
  "name": "type-practice",
  "displayName": "Type Practice",
  "description": "在 VS Code 練習打字：終端機練程式單字，編輯器逐行練習專案中的 JavaScript 與 PHP。",
  "version": "1.2.0",
  "publisher": "Zells-Zone",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "typePractice.start",
        "title": "Type Practice: Start (Words)",
        "icon": "$(keyboard)"
      },
      {
        "command": "typePractice.code",
        "title": "Type Practice: Code",
        "icon": "$(file-code)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
